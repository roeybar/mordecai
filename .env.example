# All variables are optional; the values shown are the defaults.
# Copy to .env to change them. Never put an API key here: keys are sent per
# request in the X-Provider-Key header and are not stored.
# LOG_LEVEL=INFO
# GATE_POLICY=strict
# MAX_TEXT_CHARS=4000
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# ANTHROPIC_GATE_MODEL=claude-haiku-5-5
# XAI_MODEL=grok-4.20-0309-non-reasoning
# XAI_MODELS=grok-4.20-0309-non-reasoning,grok-4.20-0309-reasoning,grok-4.3,grok-4.7
# XAI_GATE_MODEL=grok-4.20-0309-non-reasoning
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_GATE_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-6-luna
# OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol
# OPENAI_GATE_MODEL=gpt-6-luna
# WEB_PORT=8080
# FRAMES_DIR: a directory of frame docs, as a path inside the api container.
# The directory must also be mounted read-only into the api container at that
# path (for example with a compose override file); the api opens it read-only.
# An empty value selects the built-in demo frames.
# FRAMES_DIR=
# Hosted demo only (closed; see the README, Configuration). Leave these unset for local
# use. The server key (GEMINI_API_KEY) is a secret: set it in the environment of the
# compose command at run time, never here.
# HOSTED_PROVIDER=
# TRUSTED_PROXIES=
# CONTACT_EMAIL: the author's address returned by /api/health; its default is set in docker-compose.yml.
